---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CareerLine from '../components/CareerLine.astro';
import SectionHead from '../components/SectionHead.astro';

const work = await getCollection('work', ({ data }) => !data.draft);
const study = (id: string) => {
  const w = work.find((x) => x.id === id);
  return w ? { title: w.data.title, outcome: w.data.outcome, status: w.data.status, href: `/work/${w.id}` } : undefined;
};
const only = <T,>(xs: (T | undefined)[]) => xs.filter((x): x is T => Boolean(x));

const roles = [
  {
    year: '2025',
    company: 'ChargeLab',
    role: 'Senior Product Designer · Oct 2025 – Present',
    current: true,
    text: "Sole designer, leading design direction through multiple funding rounds. I lead discovery, research, design and validation with product across the driver apps and CSMS dashboard, and brought Claude and Cursor into our workflow so product and design can prototype and ship code.",
    projects: only([study('spark-ai'), study('user-management')]),
  },
  {
    year: '2024',
    company: 'ChargeLab',
    role: 'Product Designer · Jul 2024 – Oct 2025',
    text: 'Designed driver-facing experiences: onboarding, payments, the charging flow, Apple/Google Pay and social sign-in. Ran A/B tests and usability studies, led AODA accessibility work, and built design system foundations across mobile and dashboard.',
    projects: only([study('mobile-charging')]),
  },
  {
    year: '2023',
    company: 'Auvik Networks',
    role: 'UX Designer, Design Systems · Jan – Dec 2023',
    text: 'Co-led the move from the legacy system to Iceberg 2.0 with UX PMs, engineers and designers. Audited, documented and evolved the system, and led the alerting experience redesign with the Staff Designer and Platform team.',
    projects: [{ title: 'Iceberg 2.0', outcome: 'Moving a product org from a legacy design system to a new one' }],
  },
  {
    year: '2021',
    company: 'Biiibo',
    role: 'Product Designer · Aug 2021 – Jan 2023',
    text: 'Redesigned contractor ordering and checkout across web, iOS and Android. Restructured the IA, redesigned the internal dispatch and logistics dashboard, and laid early design system foundations.',
    projects: only([study('biiibo-checkout')]),
  },
];
---

<Base>
  <Hero />

  <section class="container section" aria-labelledby="work">
    <span id="experience" class="anchor" aria-hidden="true"></span>
    <SectionHead id="work" title="Work & experience" aside="8 years" />
    <CareerLine roles={roles} />
  </section>

  <section class="container section about" aria-labelledby="about">
    <SectionHead id="about" title="About" />
    <div class="about__body">
      <p class="about__lead">I come from the world of product, where I've developed a deep love for <strong>understanding customer problems</strong> and solving them through thoughtful design.</p>
      <p>I'm happiest in the messy middle: on a construction site watching a contractor fight a checkout, at a charger watching a driver guess the plug-in order, or in a card sort with my PM and EM working out what we can actually build this quarter. Lately that also means prototyping in code, so ideas get tested sooner.</p>
      <dl class="edu">
        <div><dt class="label">Education</dt><dd>BBA, University of Toronto</dd></div>
        <div><dt class="label">Certification</dt><dd>UX Design, BrainStation</dd></div>
        <div><dt class="label">Studied</dt><dd>Digital Media, OCAD</dd></div>
      </dl>
    </div>
  </section>

  <section class="container section contact" aria-labelledby="contact">
    <SectionHead id="contact" title="Contact" />
    <h2 class="contact__title">Hiring, or want to talk shop?</h2>
    <div class="contact__row">
      <button class="email" type="button" data-email="mehvish.siddique@gmail.com" data-cursor="Copy email">
        <span>mehvish.siddique@gmail.com</span><span class="email__state label">Copy</span>
      </button>
      <a class="chip" href="https://www.linkedin.com/in/mehvishsiddique/" target="_blank" rel="noopener" data-cursor="Opens LinkedIn ↗">LinkedIn ↗</a>
      <a class="chip" href="/resume.pdf" data-cursor="Résumé PDF ↓">Résumé ↓</a>
    </div>

    <div class="signoff">
      <div>
        <p class="signoff__title">Thanks for stopping by!</p>
        <p class="signoff__sub">A few things pinned to my wall outside of work.</p>
      </div>
      <div class="polaroids" aria-label="Personal photos (coming soon)">
        <span style="--r:-8deg">[Your photo]</span>
        <span style="--r:4deg">[Your photo]</span>
        <span style="--r:-3deg">[Your photo]</span>
        <span style="--r:9deg">[Your photo]</span>
      </div>
    </div>
  </section>
</Base>

<style>
  .section { position: relative; display: grid; gap: 40px; padding-block: clamp(64px, 9vw, 112px) 0; }
  .anchor { position: absolute; top: 0; }

  .about__body { display: grid; gap: 20px; max-width: var(--read); }
  .about__lead { font-size: clamp(22px, 2.6vw, 28px); line-height: 1.35; font-variation-settings: "wdth" 104; }
  .about__body > p:not(.about__lead) { color: var(--muted); }
  .edu { display: flex; gap: 32px; flex-wrap: wrap; margin: 8px 0 0; }
  .edu dd { margin: 4px 0 0; }

  .contact { padding-bottom: clamp(72px, 10vw, 120px); }
  .contact__title { font-size: clamp(34px, 5vw, 60px); font-weight: 800; font-variation-settings: "wdth" 118; letter-spacing: -.02em; }
  .contact__row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .email { display: inline-flex; gap: 14px; align-items: center; font: inherit; font-size: clamp(16px, 2vw, 19px); color: var(--on-accent); background: var(--accent); border: 0; border-radius: 999px; padding: 12px 20px; cursor: pointer; }
  .email__state { color: var(--on-accent); opacity: .7; }
  .chip { text-decoration: none; border: 1px solid var(--line); border-radius: 999px; padding: 12px 20px; color: var(--fg); background: var(--surface); transition: border-color .2s; }
  .chip:hover { border-color: var(--fg); }

  .signoff { display: flex; justify-content: space-between; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 24px; padding-top: 28px; border-top: 1px solid var(--line); }
  .signoff__title { font-size: 20px; font-weight: 600; }
  .signoff__sub { color: var(--muted); }
  .polaroids { display: flex; padding: 10px 10px 4px; }
  .polaroids span { width: 92px; aspect-ratio: 4 / 5; margin-left: -18px; background: var(--surface); padding: 6px 6px 22px; border: 1px solid var(--line);
    box-shadow: 0 2px 8px rgba(40, 32, 20, .14); rotate: var(--r); display: grid; place-items: center; text-align: center;
    font-family: var(--mono); font-size: 9px; color: var(--muted); transition: rotate .3s var(--ease), translate .3s var(--ease);
    background-image: repeating-linear-gradient(135deg, var(--raised) 0 6px, var(--surface) 6px 12px); background-clip: content-box; }
  .polaroids span:first-child { margin-left: 0; }
  .polaroids:hover span { rotate: 0deg; translate: 0 -4px; }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.email');
  btn?.addEventListener('click', async () => {
    const state = btn.querySelector('.email__state')!;
    try {
      await navigator.clipboard.writeText(btn.dataset.email!);
      state.textContent = 'Copied ✓';
    } catch {
      window.location.href = `mailto:${btn.dataset.email}`;
    }
    setTimeout(() => { state.textContent = 'Copy'; }, 2000);
  });
</script>
