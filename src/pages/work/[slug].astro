---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Layered from '../../components/case/Layered.astro';
import Status from '../../components/Status.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const all = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const i = all.findIndex((w) => w.id === entry.id);
const next = all.length > 1 ? all[(i + 1) % all.length] : undefined;
---

<Base title={`${d.title}, Mehvish Siddique`} description={d.headline}>
  <article class="container cs">
    <header class="cs__head">
      <a class="back label" href="/#work" data-cursor="Back to work">← All work</a>
      <span class="label">{d.title} · {d.company}</span>
      <h1>{d.headline}</h1>
    </header>

    <Layered {...d.opener} />

    <dl class="glance" aria-label="At a glance">
      <div><dt class="label">Role</dt><dd>{d.role}</dd></div>
      <div><dt class="label">Worked with</dt><dd>{d.workedWith}</dd></div>
      <div><dt class="label">Timeline</dt><dd>{d.timeline}</dd></div>
      <div><dt class="label">Status</dt><dd><Status value={d.status} /></dd></div>
      <div class="glance__tools"><dt class="label">Tools</dt><dd>{d.tools.join(' · ')}</dd></div>
    </dl>

    <div class="cs__content">
      <Content />
    </div>

    {next && (
      <a class="next" href={`/work/${next.id}`} data-cursor="Next case study →">
        <span class="label">Next case study</span>
        <b>{next.data.title}</b>
        <span class="next__outcome">{next.data.outcome}</span>
      </a>
    )}
  </article>
</Base>

<style>
  .cs { display: grid; gap: clamp(48px, 7vw, 80px); padding-block: clamp(40px, 6vw, 72px) 40px; }
  .cs__head { display: grid; gap: 16px; }
  .back { text-decoration: none; justify-self: start; }
  .back:hover { color: var(--fg); }
  h1 { font-size: clamp(28px, 3.8vw, 46px); font-weight: 700; font-variation-settings: "wdth" 108; letter-spacing: -.015em; line-height: 1.12; max-width: 28ch; }

  .glance { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--line); margin: 0; }
  .glance > div { padding: 18px 16px 18px 0; display: grid; gap: 6px; align-content: start; min-width: 0; }
  .glance > div + div { padding-left: 16px; border-left: 1px solid var(--line); }
  .glance dd { margin: 0; font-size: 15px; }
  .glance .glance__tools { grid-column: 1 / -1; border-left: 0; padding-left: 0; border-top: 1px solid var(--line); display: flex; gap: 16px; align-items: baseline; flex-wrap: wrap; }

  .cs__content { display: grid; gap: clamp(56px, 8vw, 96px); }

  .next { display: grid; gap: 8px; text-decoration: none; border-top: 1px solid var(--line); padding-top: 24px; }
  .next b { font-size: clamp(26px, 3.4vw, 40px); font-variation-settings: "wdth" 112; line-height: 1.1; transition: color .2s; }
  .next:hover b { color: var(--accent); }
  .next__outcome { color: var(--muted); }

  @media (max-width: 760px) {
    .glance { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .glance > div:nth-child(3) { border-left: 0; padding-left: 0; }
    .glance > div:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>
