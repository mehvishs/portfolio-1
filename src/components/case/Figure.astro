---
import Placeholder from '../Placeholder.astro';

// An annotated design decision: image with numbered pins + the "why" beside it.
// Pins pop in one by one the first time the figure scrolls into view.
interface Props {
  image: string;                       // placeholder label (later: a real image path)
  caption: string;
  ratio?: string;
  pins?: { x: number; y: number }[];   // % positions, numbered in order
  notes?: { title: string; text: string }[];
  wide?: boolean;                      // notes below instead of beside
}
const { image, caption, ratio = '16 / 10', pins = [], notes = [], wide = false } = Astro.props;
---

<figure class:list={['fig', { 'fig--wide': wide || notes.length === 0 }]}>
  <div class="fig__media">
    <div class="fig__img">
      <Placeholder label={image} ratio={ratio} />
      {pins.map((p, i) => (
        <span class="fig__pin" style={`left:${p.x}%;top:${p.y}%;--i:${i}`} aria-hidden="true">{i + 1}</span>
      ))}
    </div>
    <figcaption>{caption}</figcaption>
  </div>
  {notes.length > 0 && (
    <ol class="fig__notes">
      {notes.map((n, i) => (
        <li><span class="fig__n" aria-hidden="true">{i + 1}</span><div><b>{n.title}</b><p>{n.text}</p></div></li>
      ))}
    </ol>
  )}
</figure>

<style>
  .fig { margin: 0; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 32px; align-items: start; }
  .fig--wide { grid-template-columns: minmax(0, 1fr); }
  .fig__media { display: grid; gap: 12px; min-width: 0; }
  .fig__img { position: relative; }
  figcaption { font-size: 14px; color: var(--muted); }
  .fig__pin { position: absolute; width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%; background: var(--accent); color: var(--on-accent);
    font-family: var(--mono); font-size: 13px; font-weight: 500; display: grid; place-items: center; box-shadow: 0 0 0 6px rgba(255, 205, 53, .2); }
  .fig.is-in .fig__pin { animation: pinpop .45s var(--ease) both; animation-delay: calc(var(--i) * .35s + .2s); }
  @keyframes pinpop { 0% { transform: scale(0); } 70% { transform: scale(1.18); } 100% { transform: scale(1); } }
  .fig__notes { list-style: none; margin: 0; padding: 0; display: grid; gap: 22px; }
  .fig__notes li { display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: 12px; }
  .fig__n { width: 26px; height: 26px; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-family: var(--mono); font-size: 12px; display: grid; place-items: center; }
  .fig__notes b { display: block; margin-bottom: 4px; }
  .fig__notes p { color: var(--muted); font-size: 16px; }
  .fig--wide .fig__notes { grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); }
  @media (max-width: 820px) { .fig { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  const figs = document.querySelectorAll('.fig');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
    }), { threshold: 0.4 });
    figs.forEach((f) => io.observe(f));
  }
</script>
