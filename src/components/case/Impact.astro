---
// Big stats first, qualitative signals (slot) beside them.
interface Props {
  stats: { from?: string; to: string; label: string }[];
  heading?: string;
}
const { stats, heading = 'Impact' } = Astro.props;
---

<section class="impact" aria-label={heading}>
  <div class="impact__stats">
    {stats.map((s) => (
      <div class="stat">
        <div class="stat__num">
          {s.from && <><span class="from">{s.from}</span> <span class="arrow" aria-label="to">→</span> </>}
          <span>{s.to}</span>
        </div>
        <p>{s.label}</p>
      </div>
    ))}
  </div>
  <div class="impact__qual">
    <span class="label">What we heard</span>
    <slot />
  </div>
</section>

<style>
  .impact { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 40px; align-items: end; }
  .impact__stats { display: grid; gap: 36px; }
  .stat { display: grid; gap: 10px; }
  .stat__num { font-family: var(--display); font-weight: 800; font-variation-settings: "wdth" 125; font-size: clamp(54px, 9vw, 116px); line-height: .92; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .from { color: var(--muted); }
  .arrow { color: var(--accent-ink); }
  .stat p { color: var(--muted); max-width: 48ch; }
  .stat p :global(strong) { color: var(--fg); }
  .impact__qual { display: grid; gap: 16px; border-left: 1px solid var(--line); padding-left: 24px; }
  .impact__qual :global(p) { color: var(--muted); font-size: 16px; margin: 0; }
  .impact__qual :global(strong) { color: var(--fg); }
  @media (max-width: 820px) {
    .impact { grid-template-columns: minmax(0, 1fr); }
    .impact__qual { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: 20px; }
  }
</style>
