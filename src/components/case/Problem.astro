---
interface Props {
  label?: string;
  items: { title: string; text: string }[];
}
const { label = 'The problem', items } = Astro.props;
---

<section class="problem" aria-label={label}>
  <span class="label">{label}</span>
  <ol>
    {items.map((i) => <li><strong>{i.title}</strong><span>{i.text}</span></li>)}
  </ol>
</section>

<style>
  .problem { background: var(--raised); border-radius: 10px; padding: clamp(24px, 4vw, 44px); display: grid; gap: 22px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 28px; }
  li { display: grid; gap: 6px; align-content: start; min-width: 0; }
  strong { font-family: var(--display); font-size: 22px; font-variation-settings: "wdth" 110; line-height: 1.2; }
  span { color: var(--muted); font-size: 16px; }
</style>
