---
import Status from '../Status.astro';

interface Props {
  items: { step: string; title: string; status: 'Shipped' | 'In rollout' | 'Vision' | 'TBC'; href: string }[];
}
const { items } = Astro.props;
---

<nav class="roadmap" aria-label="What this case study covers">
  <span class="label">Roadmap</span>
  <ol style={`--n: ${items.length}`}>
    {items.map((i) => (
      <li class:list={{ done: i.status === 'Shipped' }}>
        <a href={i.href} data-cursor="Jump to section ↓">
          <span class="step">{i.step}</span>
          <b>{i.title}</b>
          <Status value={i.status} />
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .roadmap { display: grid; gap: 14px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
  li { border-top: 2px solid var(--line); min-width: 0; }
  li.done { border-top-color: var(--accent); }
  a { display: grid; gap: 8px; justify-items: start; padding: 16px 16px 16px 0; text-decoration: none; }
  li + li a { padding-left: 16px; }
  a:hover b { color: var(--accent-ink); }
  .step { font-family: var(--mono); font-size: 12px; color: var(--muted); }
  b { font-size: 17px; line-height: 1.3; transition: color .2s; }
  @media (max-width: 760px) {
    ol { grid-template-columns: minmax(0, 1fr); }
    li + li a { padding-left: 0; }
  }
</style>
