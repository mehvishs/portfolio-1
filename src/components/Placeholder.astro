---
// Stand-in for an image Mehvish will supply. Swap for <img> once exports arrive.
interface Props {
  label: string;
  ratio?: string;
}
const { label, ratio = '16 / 10' } = Astro.props;
---

<div class="ph" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Image coming soon: ${label}`}>
  <span>[IMG: {label}]</span>
</div>

<style>
  .ph { width: 100%; max-width: 100%; border-radius: 8px; border: 1px solid var(--line);
    background: repeating-linear-gradient(135deg, var(--raised) 0 14px, #ebe8e1 14px 28px);
    display: grid; place-items: center; padding: 16px; text-align: center; }
  span { font-family: var(--mono); font-size: 12px; color: var(--muted); background: var(--surface); border: 1px solid var(--line); padding: 5px 10px; border-radius: 4px; }
</style>
