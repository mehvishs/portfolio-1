---
// Homepage hero: a white-painted brick wall. At rest it's calm: just the words.
// Hovering (or tapping) research / design / ship pins a matching piece of evidence onto the wall.
---

<section class="hero" data-active="" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__copy">
      <div class="meta label">
        <span>Toronto, Canada</span>
        <span>43.6532° N, 79.3832° W</span>
        <span>Local time <time class="clock">--:--</time></span>
      </div>
      <h1 id="hero-title" class="hero__title">
        Hey! I'm Mehvish. I <span class="nw"><button class="kw" type="button" data-key="research" aria-pressed="false" aria-controls="obj-research">research</button>,</span> <button class="kw" type="button" data-key="design" aria-pressed="false" aria-controls="obj-design">design</button> and <button class="kw" type="button" data-key="ship" aria-pressed="false" aria-controls="obj-ship">ship</button> B2B&nbsp;products.
      </h1>
      <p class="hero__rest">
        8 years in. Most recently I led design at ChargeLab, partnering with product and engineering to ship AI-powered features, often writing the code alongside them.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#work" data-cursor="Scroll to work ↓">View featured work ↓</a>
        <a class="btn" href="#contact" data-cursor="Get in touch">Get in touch</a>
      </div>
      <span class="hero__hint label"><span class="hint-fine">Hover</span><span class="hint-touch">Tap</span> the underlined words</span>
    </div>

    <div class="hero__board">
      <figure class="obj obj--note" id="obj-research" data-key="research">
        <span class="tape" aria-hidden="true"></span>
        <blockquote>“What do I have to press to get to the next step? It's not obvious at all.”</blockquote>
        <figcaption>Contractor, interviewed on a construction site · Biiibo</figcaption>
      </figure>

      <figure class="obj obj--card" id="obj-design" data-key="design">
        <span class="pin" aria-hidden="true"></span>
        <svg viewBox="0 0 240 132" role="img" aria-label="Hand-drawn wireframe of a permissions screen with three levels">
          <g fill="none" stroke="#2a2722" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="6" y="6" width="228" height="120" rx="6" />
            <path d="M6 28h228" />
            <rect x="16" y="40" width="58" height="76" rx="4" />
            <path d="M24 54h40M24 68h32M24 82h38M24 96h28" />
            <rect x="86" y="40" width="138" height="20" rx="4" />
            <rect x="86" y="68" width="138" height="20" rx="4" />
            <rect x="86" y="96" width="138" height="20" rx="4" />
          </g>
          <g font-family="Caveat, cursive" font-size="15" fill="#2a2722">
            <text x="94" y="55">Super admin</text>
            <text x="94" y="83">Network</text>
            <text x="94" y="111">Company</text>
          </g>
        </svg>
        <figcaption>3 permission levels, one consistent screen · ChargeLab</figcaption>
      </figure>

      <figure class="obj obj--ship" id="obj-ship" data-key="ship">
        <span class="stamp" aria-hidden="true">Shipped</span>
        <ul>
          <li>Prototyped in Claude + Figma Make</li>
          <li>Built alongside engineering</li>
          <li>Spark output: live in production</li>
        </ul>
        <figcaption>Spark AI · ChargeLab</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-color: var(--bg);
    /* soft white wash keeps the brick quiet and the copy side readable */
    background-image:
      linear-gradient(90deg, rgba(250, 249, 246, .82) 0%, rgba(250, 249, 246, .55) 50%, rgba(250, 249, 246, .25) 100%),
      linear-gradient(0deg, var(--bg) 0%, rgba(250, 249, 246, 0) 22%),
      image-set(url('/images/brick-white.webp') type('image/webp'), url('/images/brick-white.jpg') type('image/jpeg'));
    background-size: cover;
    background-position: center;
  }
  .hero__inner { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 48px; align-items: center; padding-block: clamp(72px, 11vw, 128px) clamp(72px, 10vw, 112px); }
  .hero__copy { display: grid; gap: 28px; min-width: 0; }
  .meta { display: flex; gap: 6px 18px; flex-wrap: wrap; border-left: 2px dotted var(--dim); padding-left: 12px; }
  .hero__title { font-size: clamp(36px, 5.6vw, 66px); font-weight: 700; font-variation-settings: "wdth" 108; letter-spacing: -.02em; line-height: 1.08; }
  .nw { white-space: nowrap; }
  .kw {
    font: inherit; letter-spacing: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% .16em; background-position: 0 90%; background-repeat: no-repeat;
    transition: background-size .25s var(--ease);
  }
  .kw:hover, .kw[aria-pressed="true"] { background-size: 100% 100%; }
  .hero__rest { font-size: clamp(19px, 2vw, 23px); line-height: 1.45; color: var(--muted); max-width: 40ch; }
  .hero__ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; font-weight: 600; font-size: 15px; text-decoration: none; border: 1px solid var(--fg); border-radius: 999px; background: var(--surface); transition: background .2s, color .2s; }
  .btn:hover { background: var(--fg); color: var(--bg); }
  .btn--primary { background: var(--fg); color: var(--bg); }
  .btn--primary:hover { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .hint-touch { display: none; }
  @media (pointer: coarse) { .hint-touch { display: inline; } .hint-fine { display: none; } }

  /* evidence pinned to the wall: hidden at rest, pinned on hover/tap */
  .hero__board { position: relative; min-height: 360px; }
  .obj {
    position: absolute; top: 50%; left: 50%; margin: 0;
    opacity: 0; visibility: hidden; pointer-events: none;
    translate: -50% calc(-50% - 24px); rotate: var(--r, 0deg); scale: .96;
    transition: opacity .25s, translate .45s var(--ease), scale .45s var(--ease), visibility 0s .45s;
    box-shadow: 0 1px 2px rgba(0, 0, 0, .12), 0 18px 36px rgba(40, 32, 20, .18);
  }
  .hero[data-active="research"] .obj--note,
  .hero[data-active="design"] .obj--card,
  .hero[data-active="ship"] .obj--ship {
    opacity: 1; visibility: visible; translate: -50% -50%; scale: 1; pointer-events: auto;
    transition: opacity .2s, translate .5s cubic-bezier(.3, 1.4, .5, 1), scale .5s cubic-bezier(.3, 1.4, .5, 1), visibility 0s;
  }
  .obj figcaption { font-family: var(--mono); font-size: 10px; letter-spacing: .05em; text-transform: uppercase; margin-top: 10px; opacity: .7; }
  .obj--note { --r: -4deg; width: 240px; padding: 24px 20px 16px; background: var(--accent); color: #2a2722; }
  .obj--note blockquote { margin: 0; font-family: var(--hand); font-size: 28px; line-height: 1.05; }
  .tape { position: absolute; top: -11px; left: 50%; width: 80px; height: 24px; margin-left: -40px; background: rgba(255, 255, 255, .6); rotate: 3deg; box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .obj--card { --r: 3deg; width: 300px; padding: 18px 18px 12px; background: var(--paper); color: #2a2722; border-radius: 2px; }
  .obj--card svg { width: 100%; height: auto; }
  .pin { position: absolute; top: -8px; left: 50%; width: 16px; height: 16px; margin-left: -8px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ff8a8d, var(--danger)); box-shadow: 0 3px 5px rgba(0, 0, 0, .3); }
  .obj--ship { --r: -2deg; width: 280px; padding: 24px 20px 16px; background: var(--charcoal); color: #f2f1ee; border-radius: 8px; }
  .obj--ship ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; font-family: var(--mono); font-size: 12.5px; }
  .obj--ship li::before { content: "✓ "; color: var(--accent); }
  .stamp { position: absolute; top: -16px; right: -14px; font-family: var(--display); font-weight: 900; font-variation-settings: "wdth" 125; text-transform: uppercase; letter-spacing: .06em; font-size: 15px; color: var(--on-accent); background: var(--accent); border-radius: 6px; padding: 3px 10px; rotate: -10deg; box-shadow: 0 2px 4px rgba(0,0,0,.2); }

  @media (max-width: 880px) {
    .hero__inner { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .hero { background-image:
      linear-gradient(180deg, rgba(250, 249, 246, .78) 0%, rgba(250, 249, 246, .6) 70%, var(--bg) 100%),
      image-set(url('/images/brick-white.webp') type('image/webp'), url('/images/brick-white.jpg') type('image/jpeg')); }
    .hero__board { min-height: 0; }
    .hero[data-active=""] .hero__board { display: none; }
    .obj { position: relative; top: auto; left: auto; translate: 0 -12px; display: none; }
    .hero[data-active="research"] .obj--note,
    .hero[data-active="design"] .obj--card,
    .hero[data-active="ship"] .obj--ship { display: block; translate: 0 0; margin: 12px auto 8px; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const kws = [...hero.querySelectorAll<HTMLButtonElement>('.kw')];
  const fine = window.matchMedia('(pointer: fine)').matches;

  // live local time in Toronto
  const clock = hero.querySelector<HTMLTimeElement>('.clock');
  const fmt = new Intl.DateTimeFormat('en-CA', { hour: 'numeric', minute: '2-digit', timeZone: 'America/Toronto', timeZoneName: 'short' });
  const tick = () => { if (clock) clock.textContent = fmt.format(new Date()); };
  tick(); setInterval(tick, 30000);

  function setActive(key: string) {
    hero.dataset.active = key;
    kws.forEach((k) => k.setAttribute('aria-pressed', String(k.dataset.key === key)));
  }
  kws.forEach((k) => {
    k.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') setActive(k.dataset.key!); });
    // keyboard focus only; a tap also focuses the button, and the click handler covers taps
    k.addEventListener('focus', () => { if (k.matches(':focus-visible')) setActive(k.dataset.key!); });
    k.addEventListener('click', () => {
      // on touch, tapping the same word again unpins it
      if (!fine && hero.dataset.active === k.dataset.key) setActive('');
      else setActive(k.dataset.key!);
    });
  });
  // the last pinned piece stays until the pointer leaves the hero, so you can look at it
  hero.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') setActive(''); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setActive(''); });
</script>
